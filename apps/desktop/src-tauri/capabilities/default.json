{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main Whiphand window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "run-agent-sidecar",
          "cmd": "node",
          "args": [
            {
              "validator": "^.*[\\\\/]packages[\\\\/]agent[\\\\/]src[\\\\/]main\\.ts$"
            }
          ],
          "sidecar": false
        },
        {
          "name": "binaries/whiphand-agent",
          "sidecar": true,
          "args": []
        }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "shell:allow-open",
    "dialog:allow-open",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-inner-size",
    "core:window:allow-outer-position",
    "core:window:allow-set-title",
    "notification:default",
    "updater:default",
    "process:allow-restart",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-watch",
    "fs:allow-unwatch",
    "fs:deny-default"
  ]
}
