{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whiphand",
  "mainBinaryName": "whiphand-desktop",
  "version": "0.6.2",
  "identifier": "eu.plainbytes.whiphand.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:61337",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Whiphand",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://localhost:61337 ws://localhost:61337"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/web/**/*"
    ],
    "externalBin": [
      "binaries/whiphand"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "provides": [
          "whiphand-cli"
        ],
        "conflicts": [
          "whiphand-cli"
        ],
        "replaces": [
          "whiphand-cli"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGNTM1NTZBMEU1NjAzNEYKUldSUEExWU9hbFZUTDZjVlZPM2hYR0loWDRmUlF1VTFYT2pPaUdtaTdOeTlrQlMrMnNiSGlNcFkK",
      "endpoints": [
        "https://github.com/PlainBytes/whip-hand/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
