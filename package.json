{
  "name": "whiphand",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test --test-timeout=30000 \"scripts/*.test.mjs\" \"scripts/lib/*.test.mjs\"",
    "test:parity": "node --test --test-timeout=120000 \"parity/**/*.test.ts\"",
    "parity:golden": "node parity/regenerate-golden.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "bash scripts/verify.sh",
    "package": "npm run package:cli && npm run package:desktop",
    "package:cli": "node scripts/package/cli.mjs",
    "package:desktop": "node scripts/package/desktop.mjs",
    "reinstall": "node scripts/package/reinstall.mjs",
    "bump": "node scripts/version.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.0"
  }
}
