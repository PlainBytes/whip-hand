{
  "name": "whiphand",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test --test-force-exit --test-timeout=30000 \"packages/*/src/**/*.test.ts\" \"scripts/*.test.mjs\"",
    "test:parity": "node --test \"parity/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "verify": "bash scripts/verify.sh",
    "package": "npm run package:cli && npm run package:desktop",
    "package:cli": "node scripts/package/cli.mjs",
    "package:agent": "node scripts/package/agent.mjs",
    "package:desktop": "node scripts/package/desktop.mjs",
    "reinstall": "node scripts/package/reinstall.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.9.0"
  }
}
