{
  "name": "whiphand",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test:scripts && npm run test:rust && npm run test:desktop && npm run build:parity && npm run test:parity",
    "test:scripts": "node --test --test-timeout=30000 \"scripts/*.test.mjs\" \"scripts/lib/*.test.mjs\"",
    "test:rust": "cargo test --workspace && cargo test -p whiphand-agent --no-default-features",
    "test:desktop": "npm run test -w desktop",
    "build:parity": "cargo build --release -p whiphand-cli -p whiphand-agent",
    "test:parity": "node --test --test-timeout=120000 \"parity/**/*.test.ts\"",
    "parity:golden": "node parity/regenerate-golden.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "bash scripts/verify.sh",
    "package": "npm run package:cli && npm run package:desktop",
    "package:cli": "node scripts/package/cli.mjs",
    "package:cli-deb": "node scripts/package/cli-deb.mjs",
    "package:desktop": "node scripts/package/desktop.mjs",
    "reinstall": "node scripts/package/reinstall.mjs",
    "bump": "node scripts/version.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.0"
  }
}
